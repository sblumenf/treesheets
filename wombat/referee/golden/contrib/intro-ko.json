 ]}},
 {"path": [[0, 18]], "text": "이제 이 곳에 텍스트를 입력하기 시작합니다. 새 내용은 선택한 줄 대신 셀 사이에 표시됩니다:", "note": "", "type": "data", "formula": null, "bg": "#FFFFFF", "fg": "#000000", "relsize": 0, "stylebits": 0, "align": "auto", "valign": "auto", "render_style": "grid", "vertical_layout": true, "filtered": false, "is_tag": false, "has_image": false, "last_edit": 1749989457000, "runs": [], "links": [], "grid": {"cols": 1, "rows": 1, "folded": false, "border_color": "#A0A0A0", "col_widths": [95], "cells": [
