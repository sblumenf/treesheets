 ]}},
 {"path": [[0, 36]], "text": "매우 작게:", "note": "", "type": "data", "formula": null, "bg": "#FFFFFF", "fg": "#000000", "relsize": 0, "stylebits": 0, "align": "auto", "valign": "auto", "render_style": "grid", "vertical_layout": false, "filtered": false, "is_tag": false, "has_image": false, "last_edit": 1749993927000, "runs": [], "links": [], "grid": {"cols": 1, "rows": 1, "folded": false, "border_color": "#A0A0A0", "col_widths": [95], "cells": [
