#!/usr/bin/env python3
"""Checks the lookup export of Wombat in a real LibreOffice.

Optional, and not needed by any test: it is how the claims of docs/milestones/M7.md
about LibreOffice were verified. It

1. builds a small nested document with texts that are awkward in CSV (a semicolon, a
   comma, quotes, leading signs, leading zeros, a long number, a date, CJK names, a tab
   in a note) with the `wombat` tool, and exports it with `--format lookup --notes`;
2. opens every table in LibreOffice Calc with the settings its import dialog proposes
   (separated by comma, semicolon and tab; text delimiter "; UTF-8), headless;
3. checks that every table arrives as the rectangle that was written, with the IDs in
   the ID columns, and that each sheet is named after its file;
4. puts each nested table into the workbook of its parent, enters the formulas of
   README.txt in LibreOffice's form (XLOOKUP, INDEX/MATCH, COUNTIF) the way a person
   types them, and compares what they show with the document;
5. reports what LibreOffice made of the values (which stay text, which become numbers
   or dates).

Usage:  check_lookup_libreoffice [--wombat PATH] [--soffice PATH] [--keep]

`--soffice` (or $SOFFICE) is LibreOffice's `soffice` program, version 24.8 or later for
XLOOKUP; its own `python` beside it is used for the part that talks to it. `--wombat`
defaults to ../../target/debug/wombat. Everything is written to a fresh temporary
folder, LibreOffice's profile included. Exit status 0: every check passed.
"""
import csv
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
# What the import dialog of LibreOffice proposes for a .csv file: separators comma,
# semicolon and tab (44/59/9), text delimiter " (34), UTF-8 (76), from line 1, no column
# formats, the language of the system, "format quoted field as text" and "detect special
# numbers" off. What comes after is left to its default (formulas are evaluated).
DIALOG_DEFAULTS = "44/59/9,34,76,1,,0,false,false"

EDIT = r'''
grid / 3 3
text /1,1 "Ana; Bob"
text /2,1 "say \"hi\", twice"
text /3,1 "日本語"
text /1,2 "東京 プロジェクト"
text /2,2 "x,y"
text /3,2 "12345678901234567890"
text /1,3 "plain"
text /2,3 "2026-03-04"
text /3,3 "TRUE"
set /2,1 note="a\ttab; and, more"
grid /1,1 2 2
text /1,1/1,1 "- item one"
text /1,1/2,1 "00123"
text /1,1/1,2 "+44 20 7946 0958"
text /1,1/2,2 "=1+1"
grid /1,2 1 3
text /1,2/1,1 "@handle"
text /1,2/1,2 "-5"
text /1,2/1,3 "+SUM(1)"
save
'''


def letters(n):
    out = ""
    while True:
        out = chr(ord("A") + n % 26) + out
        n = n // 26 - 1
        if n < 0:
            return out


def read_csv(path):
    with open(path, encoding="utf-8-sig", newline="") as f:
        return list(csv.reader(f))


def uno_part(port, folder):
    """Runs under LibreOffice's python: opens the tables and enters the formulas."""
    import uno
    from com.sun.star.beans import PropertyValue

    def pv(name, value):
        p = PropertyValue()
        p.Name = name
        p.Value = value
        return p

    local = uno.getComponentContext()
    resolver = local.ServiceManager.createInstanceWithContext(
        "com.sun.star.bridge.UnoUrlResolver", local)
    for _ in range(90):
        try:
            ctx = resolver.resolve(
                "uno:socket,host=localhost,port=%d;urp;StarOffice.ComponentContext" % port)
            break
        except Exception:
            time.sleep(1)
    else:
        raise SystemExit("LibreOffice did not answer on port %d" % port)
    smgr = ctx.ServiceManager
    desktop = smgr.createInstanceWithContext("com.sun.star.frame.Desktop", ctx)
    dispatcher = smgr.createInstanceWithContext("com.sun.star.frame.DispatchHelper", ctx)

    def load(name):
        url = uno.systemPathToFileUrl(os.path.join(folder, name))
        return desktop.loadComponentFromURL(url, "_blank", 0, (
            pv("Hidden", True),
            pv("FilterName", "Text - txt - csv (StarCalc)"),
            pv("FilterOptions", DIALOG_DEFAULTS)))

    def typed(doc, sheet, address, text):
        """Types `text` into a cell, as a person does; gives what the cell shows."""
        frame = doc.CurrentController.Frame
        doc.CurrentController.setActiveSheet(doc.Sheets.getByName(sheet))
        dispatcher.executeDispatch(frame, ".uno:GoToCell", "", 0, (pv("ToPoint", address),))
        dispatcher.executeDispatch(frame, ".uno:EnterString", "", 0, (pv("StringName", text),))
        cell = doc.Sheets.getByName(sheet).getCellRangeByName(address)
        return cell.String, cell.Error

    failures = []

    def check(what, ok, detail=""):
        print("%s  %s%s" % ("ok  " if ok else "FAIL", what, (": " + detail) if detail else ""))
        if not ok:
            failures.append(what)

    version = smgr.createInstanceWithContext(
        "com.sun.star.configuration.ConfigurationProvider", ctx).createInstanceWithArguments(
        "com.sun.star.configuration.ConfigurationAccess",
        (pv("nodepath", "/org.openoffice.Setup/Product"),)).getByName("ooSetupVersionAboutBox")
    print("LibreOffice", version)

    index = read_csv(os.path.join(folder, "index.csv"))
    column = {name: n for n, name in enumerate(index[0])}
    seen_values = {}
    for entry in index[1:]:
        name = entry[column["table"]]
        stem = name[:-len(".csv")]
        written = read_csv(os.path.join(folder, name))
        doc = load(name)
        sheet = doc.Sheets.getByIndex(0)
        check("%s opens as a sheet named after it" % name, sheet.Name == stem, sheet.Name)
        # The rectangle as LibreOffice shows it, against what was written. Values that
        # LibreOffice turns into numbers or dates are noted, not failed: that is what a
        # spreadsheet does to CSV, and the summary says so.
        same_shape = True
        ids_ok = True
        for y, row in enumerate(written):
            for x, text in enumerate(row):
                cell = sheet.getCellByPosition(x, y)
                kind = cell.Type.value
                if kind == "TEXT":
                    if cell.String != text:
                        same_shape = False
                        print("      row %d column %s: wrote %r, shows %r"
                              % (y + 1, letters(x), text, cell.String))
                elif text != "":
                    seen_values[text] = (kind, cell.String)
                if written[0][x].endswith("_id") and y > 0:
                    ids_ok &= kind == "TEXT" and re.fullmatch(r"[0-9a-f-]{36}", cell.String) is not None
            # Nothing beyond the last column that was written.
            beyond = sheet.getCellByPosition(len(row), y)
            same_shape &= beyond.String == ""
        check("%s arrives as the table that was written (%d rows by %d columns)"
              % (name, len(written), len(written[0])), same_shape)
        check("%s has IDs in every ID column" % name, ids_ok)
        doc.close(True)

    readme = open(os.path.join(folder, "README.txt"), encoding="utf-8").read()
    for entry in index[1:]:
        parent_name = entry[column["parent_table"]]
        if not parent_name:
            continue
        name = entry[column["table"]]
        child, parent = name[:-4], parent_name[:-4]
        child_rows = read_csv(os.path.join(folder, name))
        parent_rows = read_csv(os.path.join(folder, parent_name))
        key = letters(child_rows[0].index("parent_row_id"))
        free = letters(len(child_rows[0]))
        row_id = letters(parent_rows[0].index("row_id"))
        parent_free = letters(len(parent_rows[0]))
        formulas = {
            "XLOOKUP": "=XLOOKUP(%s{r}, $'%s'.%s:%s, $'%s'.A:A)" % (key, parent, row_id, row_id, parent),
            "INDEX/MATCH": "=INDEX($'%s'.A:A, MATCH(%s{r}, $'%s'.%s:%s, 0))" % (parent, key, parent, row_id, row_id),
        }
        countif = "=COUNTIF($'%s'.%s:%s, %s{r})" % (child, key, key, row_id)
        # The formulas tried are the ones the README gives, for the table it gives them for.
        if ("%s is nested in %s" % (name, parent_name)) in readme:
            for what, formula in list(formulas.items()) + [("COUNTIF", countif)]:
                check("README.txt has the LibreOffice %s formula that is tried here" % what,
                      formula.format(r=2) in readme, formula.format(r=2))
        book = load(parent_name)
        source = load(name)
        book.Sheets.importSheet(source, child, 1)
        source.close(True)
        check("both sheets are in one workbook under their names",
              set(book.Sheets.ElementNames) == {child, parent}, repr(book.Sheets.ElementNames))
        # The parent row of every row of the nested table, found without a spreadsheet.
        owner = [r for r in parent_rows[1:] if r[parent_rows[0].index("row_id")] == entry[column["parent_row_id"]]]
        expected = owner[0][0]
        for what, formula in formulas.items():
            shown = []
            for r in range(2, len(child_rows) + 1):
                shown.append(typed(book, child, "%s%d" % (free, r), formula.format(r=r)))
            good = all(text == expected and error == 0 for text, error in shown)
            check("%s in %s gives %r for all %d rows" % (what, child, expected, len(shown)),
                  good, repr(shown) if not good else "")
        counts = []
        for r in range(2, len(parent_rows) + 1):
            text, error = typed(book, parent, "%s%d" % (parent_free, r), countif.format(r=r))
            counts.append(text)
        want = [str(len(child_rows) - 1) if r[parent_rows[0].index("row_id")] == entry[column["parent_row_id"]] else "0"
                for r in parent_rows[1:]]
        check("COUNTIF in %s counts the rows of %s" % (parent, child), counts == want, repr(counts))
        book.close(True)

    print("What LibreOffice made of values that are not plain text:")
    for text, (kind, shown) in sorted(seen_values.items()):
        print("      %-24r -> %s %r" % (text, kind.lower(), shown))
    return failures


def main():
    args = sys.argv[1:]
    if args[:1] == ["--uno"]:
        failures = uno_part(int(args[1]), args[2])
        print("%d checks failed" % len(failures) if failures else "all checks passed")
        sys.exit(1 if failures else 0)

    def option(name, default):
        return args[args.index(name) + 1] if name in args else default

    wombat = option("--wombat", os.path.join(HERE, "..", "..", "target", "debug", "wombat"))
    soffice = option("--soffice", os.environ.get("SOFFICE") or shutil.which("soffice"))
    if not soffice or not os.path.exists(soffice):
        sys.exit("no LibreOffice: give --soffice PATH or set SOFFICE")
    if not os.path.exists(wombat):
        sys.exit("no wombat tool at %s: build it, or give --wombat PATH" % wombat)
    lo_python = os.path.join(os.path.dirname(os.path.realpath(soffice)), "python")
    if not os.path.exists(lo_python):
        lo_python = sys.executable
    work = tempfile.mkdtemp(prefix="wombat-lo-")
    office = None
    try:
        def run(*command, **more):
            return subprocess.run(command, cwd=work, check=True, **more)
        run(wombat, "new", "doc.wombat")
        run(wombat, "edit", "doc.wombat", "--script", "-", input=EDIT.encode(), stdout=subprocess.DEVNULL)
        run(wombat, "export", "doc.wombat", "--format", "lookup", "--notes", "out", stdout=subprocess.DEVNULL)
        with socket.socket() as s:
            s.bind(("localhost", 0))
            port = s.getsockname()[1]
        office = subprocess.Popen(
            [soffice, "--headless", "--invisible", "--norestore", "--nologo",
             "-env:UserInstallation=file://" + os.path.join(work, "profile"),
             "--accept=socket,host=localhost,port=%d;urp;" % port],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        done = subprocess.run([lo_python, os.path.abspath(__file__), "--uno", str(port),
                               os.path.join(work, "out")])
        sys.exit(done.returncode)
    finally:
        if office:
            office.kill()
            subprocess.run(["pkill", "-9", "-f", "port=%d;urp" % port], check=False)
        if "--keep" in args:
            print("kept:", work)
        else:
            shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
