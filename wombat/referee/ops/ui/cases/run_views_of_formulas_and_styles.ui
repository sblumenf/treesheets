# A view of a formula cell, and a view of a bold cell with a note two rows up (the table).
lobster ts.goto_column_row(0, 3) ; ts.goto_column_row(0, 0) ; ts.set_formula("=1+1")
lobster ts.goto_column_row(0, 3) ; ts.goto_column_row(1, 0) ; ts.set_cell_type(3)
lobster ts.goto_column_row(0, 1) ; ts.goto_column_row(2, 3) ; ts.set_cell_type(3)
lobster ts.goto_column_row(0, 1) ; ts.goto_column_row(1, 1) ; ts.set_cell_type(3)
action run
