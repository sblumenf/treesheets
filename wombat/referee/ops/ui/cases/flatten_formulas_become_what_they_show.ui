# A formula cell without a grid, one with a grid, and one that shows an error: the table has
# what they showed, as plain texts.
lobster ts.goto_column_row(0, 2) ; ts.goto_column_row(0, 0) ; ts.goto_column_row(0, 1) ; ts.set_formula("=1+1")
lobster ts.goto_column_row(0, 2) ; ts.goto_column_row(0, 1) ; ts.set_formula("=3*3")
lobster ts.goto_column_row(0, 2) ; ts.goto_column_row(0, 2) ; ts.set_formula("=Missing")
select / 1 3 1 1
action flatten
